#include <windows.h>

1 ICON "app.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

WEBUI_HTML RCDATA "webui.html"
ANLEITUNG_HTML RCDATA "ANLEITUNG.html"
GUIDE_HTML RCDATA "GUIDE.html"
LICENSE_TXT RCDATA "..\\..\\LICENSE"
NOTICES_MD RCDATA "..\\..\\THIRD-PARTY-NOTICES.md"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 2,5,0,0
PRODUCTVERSION 2,5,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS VS_FF_PRERELEASE
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040704B0"
        BEGIN
            VALUE "CompanyName", "FuchsLabs"
            VALUE "FileDescription", "ScreenBuddy Developer Preview"
            VALUE "FileVersion", "2.5.0.0"
            VALUE "InternalName", "ScreenBuddy"
            VALUE "LegalCopyright", "\xA9 2026 FuchsLabs"
            VALUE "OriginalFilename", "ScreenBuddy.exe"
            VALUE "ProductName", "ScreenBuddy"
            VALUE "ProductVersion", "2.5.0-dev.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0407, 1200
    END
END
