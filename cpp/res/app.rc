#include <windows.h>

1 ICON "app.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

WEBUI_HTML RCDATA "webui.html"
ANLEITUNG_HTML RCDATA "ANLEITUNG.html"
GUIDE_HTML RCDATA "GUIDE.html"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 2,0,5,0
PRODUCTVERSION 2,0,5,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040704B0"
        BEGIN
            VALUE "CompanyName", "FuchsLabs"
            VALUE "FileDescription", "FuchsLabs USB-Display"
            VALUE "FileVersion", "2.0.5.0"
            VALUE "InternalName", "FuchsLabs-USB-Display"
            VALUE "LegalCopyright", "\xA9 2026 FuchsLabs"
            VALUE "OriginalFilename", "FuchsLabs-USB-Display.exe"
            VALUE "ProductName", "FuchsLabs USB-Display"
            VALUE "ProductVersion", "2.0.5"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0407, 1200
    END
END
