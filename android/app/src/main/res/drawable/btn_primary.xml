<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item><shape android:shape="rectangle"><solid android:color="@color/ui_primary" /><corners android:radius="12dp" />
                <stroke android:width="3dp" android:color="@color/ui_focus" /></shape></item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="@color/ui_primary" /><corners android:radius="12dp" /><stroke android:width="3dp" android:color="@color/ui_focus" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="@color/ui_primary" /><corners android:radius="12dp" /></shape>
    </item>
</selector>
